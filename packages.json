        { "source": "direct-costs",         "target": "budget",                "direction": "to",   "description": "Direct Costs post against budget line items as Actual Cost." },
        { "source": "change-events-orders", "target": "budget",                "direction": "both", "description": "Change Events drive the Revised Budget; approved Change Orders update it." },

        { "source": "change-events-orders", "target": "prime-contracts",      "direction": "to",   "description": "Approved Prime Contract Change Orders (PCCO) modify the Prime Contract value." },
        { "source": "change-events-orders", "target": "commitments",          "direction": "to",   "description": "Approved Commitment Change Orders (CCO) modify the Commitment value." },

        { "source": "prime-contracts",      "target": "invoicing",            "direction": "to",   "description": "Owner Invoices bill against the Prime Contract SOV (managed in Invoicing)." },
        { "source": "commitments",          "target": "invoicing",            "direction": "to",   "description": "Subcontractor Invoices bill against the Commitment SOV (managed in Invoicing)." },

        { "source": "budget",               "target": "reports",              "direction": "both", "description": "Reports surface Budget, cost, and contract data." },
        { "source": "budget",               "target": "analytics-setup",      "direction": "both", "description": "Analytics dashboards surface financial-tool data." },

        { "source": "cost-catalog",         "target": "estimating",           "direction": "to",   "description": "Cost Catalog items feed unit costs into Estimates." },
        { "source": "takeoff",              "target": "estimating",           "direction": "to",   "description": "Takeoffs feed quantities into Estimates." },
        { "source": "estimating",           "target": "budget",               "direction": "to",   "description": "Estimates promote to Budget." },
        { "source": "bid-board",            "target": "commitments",          "direction": "to",   "description": "Awarded bids become Commitments." },

